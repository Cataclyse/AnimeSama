+def _safe_episodes_js_url(page_url, script_src):
+    """Valide le fichier episodes.js avant toute requête."""
+    if (
+        not isinstance(script_src, str)
+        or not script_src
+        or len(script_src) > 2048
+        or any(ord(c) < 32 or ord(c) == 127 for c in script_src)
+    ):
+        raise ValueError("URL JavaScript invalide")
+
+    url = urljoin(
+        page_url.rstrip("/") + "/",
+        script_src
+    )
+
+    parsed = urlsplit(url)
+
+    if (
+        parsed.scheme != "https"
+        or parsed.hostname != "anime-sama.to"
+        or parsed.port is not None
+        or parsed.username is not None
+        or parsed.password is not None
+        or parsed.fragment
+    ):
+        raise ValueError(
+            "Destination episodes.js non autorisée"
+        )
+
+    return url
+
+
+def _fetch_anime_page(session, initial_url):
+    """Suit au maximum deux redirections HTTPS vers anime-sama.to."""
+    current = initial_url
+
+    for attempt in range(3):
+        parsed = urlsplit(current)
+
+        if (
+            parsed.scheme != "https"
+            or parsed.hostname != "anime-sama.to"
+            or parsed.port is not None
+            or parsed.username
+            or parsed.password
+            or parsed.fragment
+        ):
+            raise ValueError(
+                "Destination AnimeSama non autorisée"
+            )
+
+        response = session.get(
+            current,
+            timeout=(4, 10),
+            allow_redirects=False
+        )
+
+        if response.status_code not in (
+            301, 302, 303, 307, 308
+        ):
+            return response, current
+
+        location = response.headers.get("Location")
+        response.close()
+
+        if not location or attempt >= 2:
+            raise ValueError(
+                "Redirection absente ou limite dépassée"
+            )
+
+        current = urljoin(current, location)
+
+    raise ValueError("Trop de redirections")
 
 
