+"""Transport HTTPS à destinations et IP contrôlées — pilote DEV."""
+
+import ipaddress
+import socket
+from urllib.parse import urlsplit
+
+from requests.adapters import HTTPAdapter
+from requests.exceptions import InvalidURL
+from urllib3.connection import HTTPSConnection
+from urllib3.connectionpool import HTTPSConnectionPool
+from urllib3.exceptions import NewConnectionError
+
+
+class GuardedHTTPSConnection(HTTPSConnection):
+    def _new_conn(self):
+        try:
+            answers = socket.getaddrinfo(
+                self._dns_host,
+                self.port,
+                family=socket.AF_UNSPEC,
+                type=socket.SOCK_STREAM,
+                proto=socket.IPPROTO_TCP,
+            )
+        except socket.gaierror as exc:
+            raise NewConnectionError(
+                self, "Résolution DNS impossible"
+            ) from exc
+
+        if not answers:
+            raise NewConnectionError(
+                self, "Aucune adresse DNS"
+            )
+
+        # Vérifier TOUTES les adresses avant toute connexion.
+        for family, socktype, proto, _, address in answers:
+            try:
+                ip_text = address[0]
+                ip = ipaddress.ip_address(ip_text)
+
+                if (
+                    family not in (socket.AF_INET, socket.AF_INET6)
+                    or "%" in ip_text
+                    or not ip.is_global
+                    or ip.is_multicast
+                ):
+                    raise ValueError("Adresse non publique")
+            except ValueError as exc:
+                raise NewConnectionError(
+                    self, "Destination DNS refusée"
+                ) from exc
+
+        last_error = None
+
+        for family, socktype, proto, _, address in answers:
+            sock = None
+
+            try:
+                sock = socket.socket(family, socktype, proto)
+
+                for option in self.socket_options or ():
+                    sock.setsockopt(*option)
+
+                sock.settimeout(self.timeout)
+
+                if self.source_address:
+                    sock.bind(self.source_address)
+
+                # Connexion à l'adresse déjà vérifiée.
+                # Aucun second DNS sur le nom d'hôte.
+                sock.connect(address)
+                return sock
+
+            except OSError as exc:
+                last_error = exc
+                if sock is not None:
+                    sock.close()
+
+        raise NewConnectionError(
+            self,
+            "Connexion aux adresses publiques impossible"
+        ) from last_error
+
+
+class GuardedHTTPSPool(HTTPSConnectionPool):
+    ConnectionCls = GuardedHTTPSConnection
+
+
+class RejectHTTPAdapter(HTTPAdapter):
+    def send(self, request, **kwargs):
+        raise InvalidURL("HTTP non chiffré interdit")
+
+
+class GuardedHTTPSAdapter(HTTPAdapter):
+    def __init__(
+        self, allowed_hosts, allowed_subdomains=(), **kwargs
+    ):
+        self.allowed_subdomains = frozenset(
+            suffix.lower().strip(".")
+            for suffix in allowed_subdomains
+        )
+        self.allowed_hosts = frozenset(
+            host.lower() for host in allowed_hosts
+        )
+        super().__init__(**kwargs)
+
+    def init_poolmanager(
+        self, connections, maxsize, block=False, **kwargs
+    ):
+        super().init_poolmanager(
+            connections, maxsize, block=block, **kwargs
+        )
+        self.poolmanager.pool_classes_by_scheme = {
+            **self.poolmanager.pool_classes_by_scheme,
+            "https": GuardedHTTPSPool,
+        }
+
+    def send(self, request, **kwargs):
+        parsed = urlsplit(request.url)
+        host = (parsed.hostname or "").lower()
+
+        if (
+            parsed.scheme != "https"
+            or not (
+                host in self.allowed_hosts
+                or any(
+                    host.endswith("." + suffix)
+                    for suffix in self.allowed_subdomains
+                )
+            )
+            or parsed.port is not None
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.fragment
+        ):
+            raise InvalidURL("Destination HTTPS non autorisée")
+
+        if kwargs.get("proxies"):
+            raise InvalidURL("Proxy interdit")
+
+        if kwargs.get("verify") is not True:
+            raise InvalidURL("Vérification TLS obligatoire")
+
+        supplied_host = request.headers.get("Host")
+        if supplied_host and supplied_host.lower() != host:
+            raise InvalidURL("En-tête Host non autorisé")
+
+        return super().send(request, **kwargs)
+
+
+def configure_safe_session(
+    session, allowed_hosts, allowed_subdomains=()
+):
+    """Configure une session requests/cloudscraper dédiée."""
+    session.trust_env = False
+    session.verify = True
+
+    session.mount("http://", RejectHTTPAdapter())
+    session.mount(
+        "https://",
+        GuardedHTTPSAdapter(
+            allowed_hosts,
+            allowed_subdomains=allowed_subdomains,
+        ),
+    )
+
+    return session
