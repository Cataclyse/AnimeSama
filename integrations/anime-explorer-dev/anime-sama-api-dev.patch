@@ -0,0 +1,182 @@
+import ipaddress
+import requests
+
+from urllib.parse import urlsplit
+
+from .readers_listing import get_episode_readers
+from .utils.resolvers import (
+    RESOLVER_MAP,
+    resolve_video_url,
+    check_stream_health,
+)
+
+# Domaine actuellement validé dans le pilote Rust.
+# À étendre seulement après contrôle de la liste du proxy.
+ALLOWED_MEDIA_DOMAINS = ("vmpx.online", "vmget.online")
+
+
+def safe_https_host(raw, allow_fragment=False):
+    if not isinstance(raw, str):
+        return None
+
+    try:
+        parsed = urlsplit(raw)
+        host = (parsed.hostname or "").lower().rstrip(".")
+
+        if (
+            parsed.scheme != "https"
+            or not host
+            or parsed.username
+            or parsed.password
+            or parsed.port is not None
+            or (parsed.fragment and not allow_fragment)
+            or host.endswith(".local")
+        ):
+            return None
+
+        try:
+            ipaddress.ip_address(host)
+            return None
+        except ValueError:
+            pass
+
+        if "." not in host:
+            return None
+
+        return host
+
+    except ValueError:
+        return None
+
+
+def allowed_media_host(host):
+    return any(
+        host == domain or host.endswith("." + domain)
+        for domain in ALLOWED_MEDIA_DOMAINS
+    )
+
+
+def get_episode_sources(title, season, version, episode, primary_only=False):
+    listing = get_episode_readers(
+        title, season, version, episode
+    )
+
+    readers = listing.get("readers", [])
+
+    if primary_only:
+        # Priorité aux lecteurs déjà validés dans le pilote.
+        # Le mode all conserve l'ordre original.
+        readers = sorted(
+            readers,
+            key=lambda r: (
+                0 if r.get("host") in (
+                    "ansembed.net", "ansembed.com"
+                ) else 1
+            )
+        )
+
+    sources = []
+    seen = set()
+
+    # Limite les résolutions effectuées pour une seule requête.
+    from .safe_transport import configure_safe_session
+
+    with configure_safe_session(
+        requests.Session(),
+        allowed_hosts=set(RESOLVER_MAP) | {"vmpx.online", "vmget.online"},
+        allowed_subdomains={"vmpx.online", "vmget.online"},
+    ) as session:
+        for reader in readers[:10]:
+            original = reader.get("url", "")
+            origin_host = safe_https_host(original, allow_fragment=True)
+
+            if not origin_host:
+                continue
+
+            # Une page externe n'est résolue que si son
+            # hébergeur figure dans notre registre connu.
+            if origin_host in RESOLVER_MAP:
+                try:
+                    resolved = resolve_video_url(
+                        original, session=session
+                    )
+                except Exception:
+                    continue
+
+            elif (
+                reader.get("type") in ("hls", "mp4")
+                and allowed_media_host(origin_host)
+            ):
+                resolved = {
+                    "url": original,
+                    "type": (
+                        "m3u8"
+                        if reader["type"] == "hls"
+                        else "mp4"
+                    )
+                }
+
+            else:
+                continue
+
+            if not isinstance(resolved, dict):
+                continue
+
+            url = resolved.get("url", "")
+            kind = resolved.get("type", "")
+
+            if kind not in ("m3u8", "mp4"):
+                continue
+
+            host = safe_https_host(url)
+
+            if (
+                not host
+                or not allowed_media_host(host)
+                or url in seen
+            ):
+                continue
+
+            # Le score 1 est incertain, pas vérifié.
+            try:
+                score, healthy = check_stream_health(
+                    resolved, session=session
+                )
+            except Exception:
+                continue
+
+            if not healthy or score >= 999:
+                continue
+
+            seen.add(url)
+
+            sources.append({
+                "reader": reader.get("reader"),
+                "provider": origin_host,
+                "host": host,
+                "type": "hls" if kind == "m3u8" else "mp4",
+                "health": (
+                    "verified" if score == 0 else "uncertain"
+                ),
+                "url": url
+            })
+
+            if primary_only and score == 0:
+                break
+
+    # Les sources vérifiées passent avant les incertaines.
+    sources.sort(
+        key=lambda source:
+        0 if source["health"] == "verified" else 1
+    )
+
+    if primary_only:
+        sources = sources[:1]
+
+    return {
+        "title": title,
+        "season": season,
+        "version": version,
+        "episode": episode,
+        "sources": sources
+    }
